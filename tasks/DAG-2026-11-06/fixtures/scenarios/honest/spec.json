    "w_write": {
      "expect_prompt_contains": ["id: w_write", "允许改动的文件"],
      "tool_calls": [
        {"name": "Write", "args": {"path": "tasks/DAG-2026-11-06/fixtures/sandbox/notes.md"}}
      ],
      "write_files": {
        "tasks/DAG-2026-11-06/fixtures/sandbox/notes.md": "# A1 fixture 基线\n\n- 第一行\n- 第二行\n- 第三行\n- A1 fixture 写入行\n"
      },
      "result": {"changed": ["tasks/DAG-2026-11-06/fixtures/sandbox/notes.md"], "summary": "末尾追加一行"}
    },
    "k_check": {
      "expect_prompt_contains": ["id: k_check", "只读"],
      "tool_calls": [
        {"name": "Read", "args": {"path": "tasks/DAG-2026-11-06/fixtures/sandbox/notes.md"}}
      ],
      "result": {"verdict": "pass", "notes": "最后一行是 '- A1 fixture 写入行'"}
    }
  }
