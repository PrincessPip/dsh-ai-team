{
  "_comment": "N2（K6 并发路径）：两个只读核查同波并发，k_b 判 fail。断言点是**两条调度路径结论一致**：k_b 只跑 1 次 attempt（不重试）、k_a 照常 ok、下游 k_down 一个 attempt 都没有。",
  "nodes": {
    "w_write": {
      "expect_prompt_contains": ["id: w_write", "允许改动的文件"],
      "tool_calls": [
        {"name": "Write", "args": {"path": "tasks/DAG-2026-11-06/fixtures/sandbox/notes.md"}}
      ],
      "write_files": {
        "tasks/DAG-2026-11-06/fixtures/sandbox/notes.md": "# A1 fixture 基线\n\n- 第一行\n- 第二行\n- 第三行\n- A1 fixture 写入行\n"
      },
      "result": {"changed": ["tasks/DAG-2026-11-06/fixtures/sandbox/notes.md"], "summary": "末尾追加一行"}
    },
    "k_a": {
      "expect_prompt_contains": ["id: k_a", "只读"],
      "tool_calls": [
        {"name": "Read", "args": {"path": "tasks/DAG-2026-11-06/fixtures/sandbox/notes.md"}}
      ],
      "sleep_s": 0.3,
      "result": {"verdict": "pass", "notes": "并发组里判 pass 的那个"}
    },
    "k_b": {
      "expect_prompt_contains": ["id: k_b", "只读"],
      "tool_calls": [
        {"name": "Read", "args": {"path": "tasks/DAG-2026-11-06/fixtures/sandbox/notes.md"}}
      ],
      "sleep_s": 0.3,
      "result": {"verdict": "fail", "notes": "并发组里判 fail 的那个（B4 的 k_hash 形态）"}
    },
    "k_down": {
      "expect_prompt_contains": ["id: k_down", "只读"],
      "tool_calls": [
        {"name": "Read", "args": {"path": "tasks/DAG-2026-11-06/fixtures/sandbox/notes.md"}}
      ],
      "result": {"verdict": "pass", "notes": "这条不该被起跑（join=all，k_b 没 ok）"}
    }
  }
}
