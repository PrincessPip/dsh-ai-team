{
  "name": "dsh-ai-team",
  "version": "0.1.0",
  "description": "Give DeepSeek Harness an independent reviewer and a DAG orchestrator: separation of powers, three-state verdicts, and no evidence means no pass. 给 DSH 装上独立验收官与 DAG 编排：三权分立、三态裁决、无证据不算通过。与官方 agent-team 互补——官方管「谁来干」，本插件管「干得对不对」。",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "engine",
    "tasks",
    "templates",
    "docs",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ai-team",
    "code-review",
    "verification",
    "dag",
    "orchestration",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrincessPip/dsh-ai-team.git"
  },
  "bugs": {
    "url": "https://github.com/PrincessPip/dsh-ai-team/issues"
  },
  "homepage": "https://github.com/PrincessPip/dsh-ai-team#readme",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2 || ^0.2.1-rc.2 || ^0.2.2-rc.5 || ^0.2.3-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "scripts": {
    "check": "node --check src/index.js",
    "test": "node src/lib/verdict.test.mjs"
  }
}
